<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>QuotaBar</AssemblyName>
    <AssemblyTitle>Windows AI Quota Bar</AssemblyTitle>
    <RootNamespace>QuotaBar.App</RootNamespace>
    <ApplicationIcon>Assets\quotabar.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <ProjectReference Include="..\QuotaBar.Core\QuotaBar.Core.csproj" />
    <ProjectReference Include="..\QuotaBar.Cli\qb.csproj" />
    <Resource Include="Assets\quotabar.ico" />
    <Resource Include="Assets\icons\*.svg" />
    <Resource Include="Assets\icons\*.png" />
  </ItemGroup>
</Project>
